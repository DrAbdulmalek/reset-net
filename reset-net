#!/bin/bash
# ============================================================
# reset-net v1.4.0 — إعادة ضبط الشبكة (محسّن عن v1.3.0)
#
# الإصلاحات عن v1.3.0:
#   1. اعكس ترتيب الخطوات: احذف NM connections قبل ip rules
#      (يمنع NM من إعادة إنشاء القواعد فوراً)
#   2. أصلح كشف الواجهات: استخدم ip -o (one-line) بدل awk fallback
#   3. استبدل grep -oP بـ grep -oE + sed (محمول)
#   4. أضف whitelist للـ VPNs الشرعية (لا تحذف Tailscale, WireGuard, إلخ)
#   5. اقتل عمليات systemd-resolved العالقة قبل start
#   6. أضف فحص outline-tun1 بشكل صريح
#   7. أضف timeout لكل عملية حساسة
# ============================================================
set -uo pipefail   # لا تستخدم -e (نريد المتابعة حتى مع الأخطاء)

VERSION="1.4.0"
LOG_FILE="/var/log/reset-net.log"
ERRORS=0
WARNINGS=0

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# ── دوال مساعدة ──
log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') | $1" | tee -a "$LOG_FILE" >/dev/null
}

info()  { echo -e "${CYAN}  $1${NC}" | tee -a "$LOG_FILE" >/dev/null; }
ok()    { echo -e "${GREEN}  ✔ $1${NC}" | tee -a "$LOG_FILE" >/dev/null; }
warn()  { echo -e "${YELLOW}  ⚠ $1${NC}" | tee -a "$LOG_FILE" >/dev/null; WARNINGS=$((WARNINGS+1)); }
err()   { echo -e "${RED}  ✘ $1${NC}" | tee -a "$LOG_FILE" >/dev/null; ERRORS=$((ERRORS+1)); }

step() {
    echo ""
    echo -e "${BOLD}[$1]${NC} $2"
    log "STEP $1: $2"
}

# ── التحقق من الجذر ──
if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}يرجى تشغيل السكربت بصلاحيات الجذر: sudo $0${NC}"
    exit 1
fi

mkdir -p "$(dirname "$LOG_FILE")"
echo -e "${CYAN}${BOLD}"
echo "══════════════════════════════════════════════════"
echo "  reset-net v${VERSION} — إعادة ضبط الشبكة"
echo "══════════════════════════════════════════════════"
echo -e "${NC}"
log "=== بدء reset-net v${VERSION} ==="

# Whitelist: واجهات/اتصالات لا يجب حذفها أبداً
VPN_WHITELIST=("tailscale" "tailscale0" "wg0" "wg1" "wgpia" "mullvad" "protonvpn")

is_whitelisted() {
    local name="$1"
    local wl
    for wl in "${VPN_WHITELIST[@]}"; do
        if [[ "$name" == *"$wl"* ]]; then
            return 0  # whitelisted
        fi
    done
    return 1  # not whitelisted
}

# ═══════════════════════════════════════════════════════════
# [1/11] إيقاف خدمات Outline
# ═══════════════════════════════════════════════════════════
step "1/11" "إيقاف خدمات Outline"

# إيقاف systemd service إن وُجد
for svc in outline-client outline-internal-proxy outline-proxy; do
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
        systemctl stop "$svc" 2>/dev/null && ok "توقف $svc" || warn "فشل إيقاف $svc"
    else
        info "$svc غير نشط"
    fi
done

# قتل العمليات المتبقية
for proc in outline-client outline-internal-proxy; do
    if pgrep -x "$proc" >/dev/null 2>&1; then
        pkill -9 -x "$proc" 2>/dev/null && ok "قُتلت عمليات $proc" || warn "فشل قتل $proc"
    else
        info "لا عمليات $proc"
    fi
done

# ═══════════════════════════════════════════════════════════
# [2/11] حذف اتصالات NetworkManager للـ VPN (قبل كل شيء آخر!)
# ═══════════════════════════════════════════════════════════
# v1.4.0: نقلنا هذه الخطوة قبل حذف ip rules!
# السبب: NM يعيد إنشاء ip rules فوراً إذا كان الاتصال لا يزال نشطاً.
# يجب حذف الاتصال من NM أولاً، ثم تنظيف القواعد المتبقية.
step "2/11" "حذف اتصالات NetworkManager للـ VPN (أولاً)"

NM_CLEANED=0
while IFS=: read -r uuid name type; do
    [[ -z "$uuid" ]] && continue

    # تخطي المُدرجة في whitelist
    if is_whitelisted "$name"; then
        info "تخطي (whitelist): $name"
        continue
    fi

    # حذف إذا كان نوع tun/vpn أو اسمه يحتوي على outline/vpn
    if [[ "$type" == "tun" ]] || [[ "$type" == "vpn" ]] || \
       [[ "$name" == *[Oo]utline* ]] || [[ "$name" == *[Vv][Pp][Nn]* ]]; then
        nmcli connection delete "$uuid" 2>/dev/null && ok "حُذف اتصال NM: $name ($type)" && NM_CLEANED=1 || warn "فشل حذف $name"
    fi
done < <(nmcli -t -f UUID,NAME,TYPE connection show 2>/dev/null)

if [[ $NM_CLEANED -eq 0 ]]; then
    info "لا اتصالات VPN في NetworkManager"
fi

# ═══════════════════════════════════════════════════════════
# [3/11] حذف واجهات TUN/TAP المتبقية (بأي اسم)
# ═══════════════════════════════════════════════════════════
step "3/11" "حذف واجهات TUN/TAP المتبقية"

# v1.4.0: استخدم ip -o (one-line) — أكثر موثوقية من awk fallback
DELETED_ANY=0
while IFS= read -r line; do
    # الصيغة: "10: outline-tun1: <POINTOPOINT,...> ..."
    iface=$(echo "$line" | awk -F': ' '{print $2}' | awk '{print $1}')
    [[ -z "$iface" ]] && continue

    # تخطي المُدرجة في whitelist
    if is_whitelisted "$iface"; then
        info "تخطي (whitelist): $iface"
        continue
    fi

    # مطابقة tun*, tap*, outline*
    if [[ "$iface" =~ ^(tun|tap|outline) ]]; then
        ip link set "$iface" down 2>/dev/null || true
        if ip tuntap show 2>/dev/null | grep -q "^${iface}:"; then
            ip tuntap del mode tun name "$iface" 2>/dev/null || \
            ip tuntap del mode tap name "$iface" 2>/dev/null || true
        fi
        ip addr flush dev "$iface" 2>/dev/null || true
        ok "حذف/إيقاف: $iface"
        DELETED_ANY=1
    fi
done < <(ip -o link show 2>/dev/null)

if [[ $DELETED_ANY -eq 0 ]]; then
    info "لا واجهات TUN/TAP بقايا"
fi

# ═══════════════════════════════════════════════════════════
# [4/11] تنظيف iptables (IPv4)
# ═══════════════════════════════════════════════════════════
step "4/11" "تنظيف iptables (IPv4)"

iptables -F 2>/dev/null && ok "تفريغ سلاسل iptables" || warn "فشل iptables -F"
iptables -X 2>/dev/null && ok "حذف السلاسل المخصصة" || true
iptables -t nat -F 2>/dev/null && ok "تفريغ NAT" || true
iptables -t nat -X 2>/dev/null || true
iptables -t mangle -F 2>/dev/null && ok "تفريغ mangle" || true
iptables -t mangle -X 2>/dev/null || true
iptables -P INPUT ACCEPT 2>/dev/null
iptables -P FORWARD ACCEPT 2>/dev/null
iptables -P OUTPUT ACCEPT 2>/dev/null

# ═══════════════════════════════════════════════════════════
# [5/11] تنظيف ip6tables (IPv6)
# ═══════════════════════════════════════════════════════════
step "5/11" "تنظيف ip6tables (IPv6)"

ip6tables -F 2>/dev/null && ok "تفريغ ip6tables" || warn "فشل ip6tables -F"
ip6tables -X 2>/dev/null || true
ip6tables -t nat -F 2>/dev/null || true
ip6tables -t mangle -F 2>/dev/null || true
ip6tables -P INPUT ACCEPT 2>/dev/null
ip6tables -P FORWARD ACCEPT 2>/dev/null
ip6tables -P OUTPUT ACCEPT 2>/dev/null

# ═══════════════════════════════════════════════════════════
# [6/11] مسح nftables وإعادة تشغيل firewalld
# ═══════════════════════════════════════════════════════════
step "6/11" "مسح nftables وإعادة تشغيل firewalld"

nft flush ruleset 2>/dev/null && ok "تم مسح nftables" || info "nftables غير مستخدم أو غير مثبت"

if systemctl is-active --quiet firewalld 2>/dev/null; then
    systemctl restart firewalld 2>/dev/null && ok "أُعيد تشغيل firewalld" || warn "فشل إعادة تشغيل firewalld"
else
    info "firewalld غير نشط"
fi

# ═══════════════════════════════════════════════════════════
# [7/11] حذف مسارات ونقاط توجيه VPN المتبقية
# ═══════════════════════════════════════════════════════════
# v1.4.0: الآن بعد حذف NM connections (خطوة 2)، القواعد لن تُعاد إنشاؤها
step "7/11" "حذف مسارات ونقاط توجيه VPN المتبقية"

# جمع كل قواعد ip rule أولاً (snapshot)، ثم حذفها
RULES_CLEANED=0
STANDARD_PREFS="0 32766 32767"

ip rule show 2>/dev/null | while IFS= read -r line; do
    pref=$(echo "$line" | awk '{print $1}' | tr -d ':')
    [[ -z "$pref" ]] && continue

    # تخطي القواعد القياسية
    if echo "$STANDARD_PREFS" | grep -qw "$pref"; then
        continue
    fi

    # حذف القاعدة
    ip rule del pref "$pref" 2>/dev/null && echo "DELETED:$pref" || echo "FAILED:$pref"
done | while read -r result; do
    if [[ "$result" == DELETED:* ]]; then
        ok "حذف قاعدة ip rule: ${result#DELETED:}"
    else
        warn "فشل حذف قاعدة: ${result#FAILED:}"
    fi
done

# v1.4.0: تفريغ جداول التوجيه المخصصة باستخدام grep -oE (محمول)
TABLES_CLEANED=0
for tbl in $(ip route show table all 2>/dev/null | \
             grep -oE 'table [^ ]+' | sed 's/table //' | sort -u); do
    # تخطي الجداول القياسية
    if [[ "$tbl" == "main" ]] || [[ "$tbl" == "default" ]] || [[ "$tbl" == "local" ]]; then
        continue
    fi
    ip route flush table "$tbl" 2>/dev/null && ok "تفريغ جدول توجيه: $tbl" || warn "فشل تفريغ جدول $tbl"
done

# مسح ARP cache
ip neigh flush all 2>/dev/null && ok "تم مسح ARP cache" || true

# ═══════════════════════════════════════════════════════════
# [8/11] إصلاح DNS وإعادة تشغيل systemd-resolved
# ═══════════════════════════════════════════════════════════
step "8/11" "إصلاح DNS وإعادة تشغيل systemd-resolved"

# v1.4.0: اقتل العمليات العالقة أولاً
if pgrep -x systemd-resolve >/dev/null 2>&1; then
    kill -9 $(pgrep -x systemd-resolve) 2>/dev/null || true
    info "قُتلت عمليات systemd-resolved العالقة"
fi

systemctl stop systemd-resolved 2>/dev/null || true
sleep 1
systemctl start systemd-resolved 2>/dev/null && ok "systemd-resolved يعمل" || warn "فشل تشغيل systemd-resolved"
sleep 2

# فحص resolv.conf
if [[ -L /etc/resolv.conf ]]; then
    target=$(readlink -f /etc/resolv.conf 2>/dev/null || true)
    if [[ "$target" == *"systemd"* ]] || [[ "$target" == *"resolve"* ]]; then
        ok "resolv.conf موصول بـ systemd-resolved"
    else
        warn "resolv.conf symlink غير متوقع: $target"
    fi
else
    warn "resolv.conf ليس symlink — إصلاح..."
    rm -f /etc/resolv.conf
    ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf 2>/dev/null && ok "resolv.conf أُصلح" || warn "فشل إصلاح resolv.conf"
fi

# ═══════════════════════════════════════════════════════════
# [9/11] إعادة تفعيل الشبكة عبر NetworkManager
# ═══════════════════════════════════════════════════════════
step "9/11" "إعادة تفعيل الشبكة عبر NetworkManager"

nmcli networking off 2>/dev/null && ok "تم إيقاف الشبكة" || warn "فشل إيقاف الشبكة"
sleep 2
nmcli networking on 2>/dev/null && ok "تم تشغيل الشبكة" || warn "فشل تشغيل الشبكة"
sleep 3

# فحص حالة الأجهزة
ACTIVE_DEV=$(nmcli -t -f DEVICE,STATE device status 2>/dev/null | awk -F: '$2=="connected" {print $1}' | head -n1)
if [[ -z "$ACTIVE_DEV" ]]; then
    warn "لا يوجد جهاز متصل — محاولة إعادة تفعيل WiFi/Ethernet..."
    for dev in $(nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2=="wifi" || $2=="ethernet" {print $1}'); do
        nmcli device reapply "$dev" 2>/dev/null || nmcli device connect "$dev" 2>/dev/null || true
    done
    sleep 3
fi

# ═══════════════════════════════════════════════════════════
# [10/11] فحص نهائي لقواعد ip rule المتبقية
# ═══════════════════════════════════════════════════════════
step "10/11" "فحص نهائي لقواعد ip rule المتبقية"

REMAINING_RULES=$(ip rule show 2>/dev/null | grep -vE '^[0-9]+:\s+from all lookup (local|main|default)' || true)
if [[ -n "$REMAINING_RULES" ]]; then
    warn "قواعد ip rule غير قياسية ما زالت موجودة:"
    echo "$REMAINING_RULES" | while IFS= read -r line; do
        info "  $line"
    done
    warn "قد تحتاج لإعادة تشغيل النظام لحذفها نهائياً"
else
    ok "لا قواعد ip rule غير قياسية متبقية"
fi

# ═══════════════════════════════════════════════════════════
# [11/11] التحقق من الاتصال
# ═══════════════════════════════════════════════════════════
step "11/11" "التحقق من الاتصال"

info "انتظار استقرار الشبكة..."
sleep 3

# اختبار IPv4
if ping -c 2 -W 5 8.8.8.8 >/dev/null 2>&1; then
    ok "الاتصال بـ 8.8.8.8 ناجح"
else
    err "فشل الاتصال بـ 8.8.8.8"
fi

# اختبار DNS
if ping -c 2 -W 5 google.com >/dev/null 2>&1; then
    ok "DNS يعمل (google.com يستجيب)"
else
    err "DNS لا يحل الأسماء — جرب: sudo systemctl restart systemd-resolved"
fi

# اختبار IPv6 (اختياري)
if ping -c 1 -W 3 ipv6.google.com >/dev/null 2>&1; then
    ok "IPv6 يعمل"
else
    info "IPv6 غير متاح (قد يكون طبيعياً)"
fi

# ── الملخص النهائي ──
echo ""
echo -e "${CYAN}${BOLD}══════════════════════════════════════════════════${NC}"
if [[ $ERRORS -eq 0 ]]; then
    if [[ $WARNINGS -eq 0 ]]; then
        echo -e "${GREEN}${BOLD}  تمت إعادة الضبط بنجاح — الاتصال يعمل!${NC}"
    else
        echo -e "${YELLOW}${BOLD}  اكتمل بـ ${WARNINGS} تحذيرات غير حرجة${NC}"
    fi
else
    echo -e "${RED}${BOLD}  اكتمل بـ ${ERRORS} خطأ/أخطاء${NC}"
    echo -e "${YELLOW}  راجع: $LOG_FILE${NC}"
    echo ""
    echo -e "${YELLOW}  خطوات يدوية إضافية:${NC}"
    echo -e "    1) ip addr show   (هل للواجهة IP؟)"
    echo -e "    2) ip route show  (هل يوجد default route؟)"
    echo -e "    3) ip rule show   (هل بقيت قواعد policy routing؟)"
    echo -e "    4) nmcli device status"
    echo -e "    5) sudo systemctl restart systemd-resolved"
fi
echo -e "${CYAN}${BOLD}══════════════════════════════════════════════════${NC}"
log "=== انتهى reset-net v${VERSION} (أخطاء: $ERRORS، تحذيرات: $WARNINGS) ==="
